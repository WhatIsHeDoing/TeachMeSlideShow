{
  "author": {
    "name": "Darren Hickling",
    "url": "https://darrenhickling.com"
  },
  "dependencies": {
    "@vitejs/plugin-react-swc": "4.2.3",
    "keycode-js": "3.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-event-listener": "0.6.7",
    "react-swipeable": "7.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-svgr": "4.5.0",
    "vite-tsconfig-paths": "6.1.1"
  },
  "description": "Slideshow education!",
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-event-listener": "0.4.15",
    "@vitest/coverage-v8": "4.0.18",
    "cspell": "9.6.4",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "16.2.7",
    "npm-run-all": "4.1.5",
    "sharp": "0.34.5",
    "vitest": "4.0.18"
  },
  "keywords": [
    "education",
    "fun",
    "react",
    "slideshow",
    "typescript"
  ],
  "license": "Unlicense",
  "name": "alphabet-slideshows",
  "packageManager": "pnpm@10.21.0",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "ci": "run-s build lint migrate spellcheck test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "migrate": "biome migrate --write",
    "serve": "vite preview",
    "spellcheck": "cspell **/*",
    "start": "vite",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css}": "biome check",
    "**/*": "cspell --no-must-find-files"
  },
  "version": "3.0.0"
}