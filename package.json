{
  "author": {
    "name": "Darren Hickling",
    "url": "https://darrenhickling.com"
  },
  "dependencies": {
    "@vitejs/plugin-react-swc": "4.3.3",
    "keycode-js": "3.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-event-listener": "0.6.7",
    "react-swipeable": "7.0.2",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-svgr": "5.2.0",
    "vite-tsconfig-paths": "6.1.1"
  },
  "description": "Slideshow education!",
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-event-listener": "0.4.15",
    "@vitest/coverage-v8": "4.1.10",
    "cspell": "10.0.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.3.0",
    "npm-run-all": "4.1.5",
    "sharp": "0.35.3",
    "vitest": "4.1.10"
  },
  "keywords": [
    "education",
    "fun",
    "react",
    "slideshow",
    "typescript"
  ],
  "license": "Unlicense",
  "name": "alphabet-slideshows",
  "packageManager": "pnpm@10.21.0",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "ci": "run-s build lint migrate spellcheck test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "migrate": "biome migrate --write",
    "serve": "vite preview",
    "spellcheck": "cspell **/*",
    "start": "vite",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,json,css}": "biome check",
    "**/*": "cspell --no-must-find-files"
  },
  "version": "3.0.0"
}